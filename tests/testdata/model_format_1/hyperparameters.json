{
  "format": 1,
  "schnetpack_version": "3.0.0",
  "model": {
    "_target_": "schnetpack.model.NeuralNetworkPotential",
    "representation": {
      "_target_": "schnetpack.model.PaiNN",
      "n_atom_basis": 8,
      "n_interactions": 1,
      "radial_basis": {
        "_target_": "schnetpack.nn.GaussianRBF",
        "n_rbf": 6,
        "cutoff": 5.0
      },
      "cutoff_fn": {
        "_target_": "schnetpack.nn.CosineCutoff",
        "cutoff": 5.0
      },
      "activation": {
        "_target_": "torch.nn.functional.silu",
        "_partial_": true
      }
    },
    "input_modules": [
      {
        "_target_": "schnetpack.model.PairwiseDistances"
      }
    ],
    "output_modules": [
      {
        "_target_": "schnetpack.model.Atomwise",
        "n_in": 8,
        "activation": {
          "_target_": "torch.nn.SiLU",
          "inplace": false
        },
        "output_key": "energy"
      },
      {
        "_target_": "schnetpack.model.Forces"
      }
    ],
    "postprocessors": [
      {
        "_target_": "schnetpack.transform.CastTo64"
      },
      {
        "_target_": "schnetpack.transform.AddOffsets",
        "property": "energy",
        "add_mean": true,
        "add_atomrefs": true,
        "atomrefs": {
          "_tensor_": {
            "shape": [
              100
            ],
            "dtype": "float64"
          }
        }
      }
    ],
    "do_postprocessing": true
  }
}
